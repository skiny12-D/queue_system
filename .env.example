# Exemplo de variáveis de ambiente para o queue_system
# Não coloque credenciais reais neste ficheiro no repositório público.

# SMTP (envio de e-mail)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=utilizador@exemplo.com
SMTP_PASS=senha

# Twilio (envio de SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+1234567890

# Alertas
ALERT_THRESHOLD=4
ALERT_CHECK_INTERVAL=5
